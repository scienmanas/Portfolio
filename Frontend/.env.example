# Canonical site origin. Required — the build fails in app/(default_site)/layout.tsx
# on `new URL(process.env.SITE_URL)` when this is unset.
#
# WARNING: `npm run build` runs next-sitemap as a postbuild step, which rewrites the
# committed public/robots.txt, public/sitemap.xml and public/sitemap-0.xml using this
# value. Building with a placeholder origin will silently corrupt those files.
SITE_URL=https://scienmanas.dev

# Site name used in metadata.
SITE_NAME=Manas | Portfolio

# Google Analytics measurement ID, consumed by @next/third-parties.
G_ANALYTICS_ID=
